model Business {
  accountId Int      @id
  account   Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  
  companyName         String
  jurisdiction        String?
  registrationNumber String?
  businessType        String?

  entities BusinessEntity[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
}
