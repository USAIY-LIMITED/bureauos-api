enum AccountType {
  ADMIN
  BUSINESS
  PROFESSIONAL
}

model Account {
  ...boilerplate
  type               AccountType
  users              User[]
  admin              Admin?
  business           Business?
  professional       Professional?
  
  apiGateways        ApiGateway[]         @relation("AccountApiGateways")
  blogPosts          BlogPost[]
  createdDocumentProceedings      DocumentProceeding[] @relation("DocumentProceedingCreatedBy")
  businessDocumentProceedings     DocumentProceeding[] @relation("BusinessDocumentProceedings")
  professionalDocumentProceedings DocumentProceeding[] @relation("ProfessionalDocumentProceedings")
  requestedDocumentItems          DocumentItem[]       @relation("DocumentItemRequestedBy")
  uploadedDocumentItems           DocumentItem[]       @relation("DocumentItemUploadedBy")
  uploadedDocumentVersions        DocumentVersion[]    @relation("DocumentVersionUploadedBy")
  documentComments                DocumentComment[]    @relation("DocumentCommentAuthor")
  documentActivities              DocumentActivity[]   @relation("DocumentActivityActor")
  badges                          AccountBadge[]       @relation("AccountBadges")

  identityCode       String?

  @@index([type])
}
