enum WaitlistAccountType {
  Founder
  Professional
}

model Waitlist {
  ...boilerplate
  email           String   @unique
  fullName        String
  linkedinProfile String?
  country         String
  accountType     WaitlistAccountType
  founderStage    String?
  professionalCategory String?
  companyName     String?
  rolePosition    String?
  expansionTarget String[] @default([])
  segments        String[] @default([])
  step            Int      @default(1)
  lastSent        DateTime?
  biggestChallenge String
  challengeArea   String
  bosHelp         String?
  wantsNewsletter Boolean
  subscribed_for_waitlist Boolean @default(true)

  @@index([email, accountType])
}
